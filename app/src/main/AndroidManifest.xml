<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- T-3.6 / D-12. The `camera` foreground service type is the only one without a time
         limit, which an all-night session needs; it is while-in-use restricted, so the service
         is started from the Start tap while the app is visible. WAKE_LOCK because the screen
         going off must not suspend the process — measured, see plan §1.7. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- T-6.4 / D-12. Stacking is a *separate* service from capture and takes a different type:
         `mediaProcessing` on API 35+, `dataSync` below it. Both carry a 6 h budget and a
         mandatory onTimeout(), which is fine for a stack measured in minutes and would be fatal
         for an all-night capture — which is why capture keeps `camera` and these are not shared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Latitude drives the field-rotation rate and the dec-corrected trailing limit (FR-5.1).
         Denial is survivable: pointing still reports alt/az, and the exposure engine falls
         back to the pole-agnostic form and says so. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Declared, never required: the app must be installable on a device it cannot
         support, so that FR-3.1's qualification screen can explain *why* it can't. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.raw" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- T-1.3's second clause: hand the camera to another app and watch it take one. Package
         visibility is filtered from API 30, so without this the phone's own camera app cannot be
         resolved and "nothing else answers" is indistinguishable from "nothing else exists". -->
    <queries>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:name=".StarStackerApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_camera"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StarStacker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.StarStacker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Both types are declared because the one that applies depends on the API level the app
             is running on, not on what it was built against. -->
        <service
            android:name=".stacking.StackingService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
